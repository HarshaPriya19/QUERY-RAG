# Copy to .env if you want a real LLM. The experiment runs without these.
# Default provider is local, so a key in the environment is not used unless you opt in.

LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# rules (default, reproducible) or llm
JUDGE_BACKEND=rules

# Set to 0 to disable the local rewriter's documented failure modes.
REWRITER_FAILURES=1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVE_K=3
ANSWER_K=1
